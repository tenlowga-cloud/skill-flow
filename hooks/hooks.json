{
  "description": "skill-flow: remind the model to run the flow on every prompt that asks for work.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/prompt-gate.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
